# Ignore Python bytecode
__pycache__/
*.py[cod]

# Ignore checkpoints
*.ckpt
*.pth
*.pt
*.h5

# Ignore images
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.gif

# Ignore temporary files
*.log
*.tmp
*.swp
*.DS_Store

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore environment files (optional)
.env/
*.env
